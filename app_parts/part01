    return RedirectResponse("/login", status_code=303)


@app.get("/", response_class=HTMLResponse)
def dashboard(request: Request):
    if red := auth_redirect(request):
        return red
    conn = get_db()
    stats = {
        "clients": conn.execute("SELECT COUNT(*) FROM clients WHERE status='active'").fetchone()[0],
        "projects": conn.execute("SELECT COUNT(*) FROM projects WHERE status NOT IN ('completed','cancelled')").fetchone()[0],
        "tasks": conn.execute("SELECT COUNT(*) FROM tasks WHERE status!='done'").fetchone()[0],
        "unpaid": conn.execute("SELECT COALESCE(SUM(amount),0) FROM invoices WHERE status!='paid'").fetchone()[0],
        "revenue": conn.execute("SELECT COALESCE(SUM(amount),0) FROM payments").fetchone()[0],
    }
    recent_tasks = conn.execute(
        """SELECT tasks.*,projects.name project_name,users.name assignee FROM tasks
        LEFT JOIN projects ON projects.id=tasks.project_id
        LEFT JOIN users ON users.id=tasks.assigned_to ORDER BY tasks.id DESC LIMIT 6"""
    ).fetchall()
    recent_invoices = conn.execute(
        """SELECT invoices.*,clients.name client_name,
        COALESCE((SELECT SUM(amount) FROM payments p WHERE p.invoice_id=invoices.id),0) paid_amount
        FROM invoices LEFT JOIN clients ON clients.id=invoices.client_id ORDER BY invoices.id DESC LIMIT 6"""
    ).fetchall()
    conn.close()
    return render(request, "dashboard.html", stats=stats, recent_tasks=recent_tasks, recent_invoices=recent_invoices)


