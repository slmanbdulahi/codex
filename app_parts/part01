def auth_redirect(request: Request):
    if not request.session.get("user_id"):
        return RedirectResponse("/login", status_code=303)
    return None


def admin_redirect(request: Request):
    red = auth_redirect(request)
    if red:
        return red
    if request.session.get("role") != "admin":
        return RedirectResponse("/?error=Admin+access+required", status_code=303)
    return None


def render(request: Request, name: str, **ctx):
    messages = []
    if request.query_params.get("ok"):
        messages.append(("success", request.query_params["ok"]))
    if request.query_params.get("error"):
        messages.append(("error", request.query_params["error"]))
    data = {
        "request": request,
        "session": request.session,
        "messages": messages,
        "csrf_token": csrf_token(request),
        **ctx,
    }
    return templates.TemplateResponse(request=request, name=name, context=data)


def audit(user_id: int | None, action: str, entity_type="", entity_id=None, details=""):
    if not user_id:
        return
    conn = get_db()
    conn.execute(
        "INSERT INTO audit_logs (user_id,action,entity_type,entity_id,details,created_at) VALUES (?,?,?,?,?,?)",
        (user_id, action, entity_type, entity_id, details, now()),
    )
    conn.commit()
    conn.close()


def next_invoice_no(conn):
    year = datetime.utcnow().year
    n = conn.execute("SELECT COUNT(*) FROM invoices").fetchone()[0] + 1
    return f"ZUB-{year}-{n:04d}"


