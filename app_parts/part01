@app.post("/login")
async def login(request: Request):
    form = await request.form()
    if not csrf_valid(request, form): return csrf_failure()
    email = str(form.get("email", "")).strip().lower()
    password = str(form.get("password", ""))
    conn = get_db()
    user = conn.execute("SELECT * FROM users WHERE email=? AND active=1", (email,)).fetchone()
    conn.close()
    if user and verify_password(password, user["password_hash"]):
        request.session.clear()
        request.session.update({"user_id": user["id"], "name": user["name"], "role": user["role"]})
        audit(user["id"], "login", "user", user["id"])
        return RedirectResponse("/", status_code=303)
    return RedirectResponse("/login?error=Invalid+email+or+password", status_code=303)


