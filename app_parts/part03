@app.post("/account/password")
async def password_change(request: Request):
    if red := auth_redirect(request): return red
    f = await request.form()
    if not csrf_valid(request, f): return csrf_failure()
    current = str(f.get("current_password", ""))
    new = str(f.get("new_password", ""))
    confirm = str(f.get("confirm_password", ""))
    if len(new) < 10:
        return RedirectResponse("/account/password?error=New+password+must+be+at+least+10+characters", 303)
    if new != confirm:
        return RedirectResponse("/account/password?error=New+passwords+do+not+match", 303)
    conn = get_db()
    user = conn.execute("SELECT * FROM users WHERE id=?", (request.session["user_id"],)).fetchone()
    if not user or not verify_password(current, user["password_hash"]):
        conn.close()
        return RedirectResponse("/account/password?error=Current+password+is+incorrect", 303)
    conn.execute("UPDATE users SET password_hash=? WHERE id=?", (hash_password(new), user["id"]))
    conn.commit(); conn.close()
    audit(user["id"], "password_changed", "user", user["id"])
    return RedirectResponse("/account/password?ok=Password+changed+successfully", 303)


